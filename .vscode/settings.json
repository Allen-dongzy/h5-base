{
  // i18n-ally 配置
  "i18n-ally.localesPaths": [
    "src/locales"
  ],
  // 文件折叠
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "*.ts": "$(capture).test.ts, $(capture).test.tsx",
    "*.tsx": "$(capture).test.ts, $(capture).test.tsx",
    "*.env": "$(capture).env.*",
    "CHANGELOG.md": "CHANGELOG*",
    "project.config.json": "project.*.json",
    "package.json": "pnpm-lock.yaml,pnpm-workspace.yaml,LICENSE,.gitattributes,.gitignore,.gitpod.yml,CNAME,README*,.npmrc,.browserslistrc,",
    ".eslintrc.*": ".eslintignore,.prettierignore,.stylelintignore,commitlint.*,.commitlintrc.*,.prettierrc.*,.stylelintrc.*,.eslintrc-components.json,.eslintrc-auto-import.json,postcss*"
  },
}